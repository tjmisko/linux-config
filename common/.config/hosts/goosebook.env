# GooseBook -- Wayland / Hyprland laptop (Apple Silicon, Asahi).
#
# Verified on GooseBook 2026-09-09: ${HOSTNAME,,} prints goosebook, and
# /sys/class/power_supply lists macsmc-battery and macsmc-ac. The old root
# layout hardcoded font_size = 14 in wezterm.lua and exec'd start-hyprland
# unconditionally on tty1, which the two values below reproduce.

export AUTOSTART_SESSION=hyprland

# Asahi exposes the Apple SMC power devices under these names. GooseBook runs
# waybar rather than polybar, so these matter only if it ever runs an X session.
export POLYBAR_BATTERY=macsmc-battery
export POLYBAR_ADAPTER=macsmc-ac
export POLYBAR_FONT='monospace:size=14;0'

export WEZTERM_FONT_SIZE=14
