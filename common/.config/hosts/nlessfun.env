# nlessfun -- X11 / i3 laptop.
#
# Sourced by .bashrc from .config/hosts/$(hostname -s, lowercased).env.
# Values must be exported: polybar and wezterm read them from the process
# environment, having been started by i3 from this login shell.
# Every consumer has a fallback, so a host with no file here still works.

# Graphical session to exec on a tty1 login: hyprland | startx | empty.
# Empty means land at a shell. Start X by hand with `startx`.
export AUTOSTART_SESSION=

# Battery devices as named under /sys/class/power_supply on this machine.
export POLYBAR_BATTERY=BAT0
export POLYBAR_ADAPTER=ADP1

# This panel runs larger than GooseBook's. POLYBAR_FONT's built-in fallback
# is already monospace:size=18;0, so polybar needs no override here.
export WEZTERM_FONT_SIZE=23
