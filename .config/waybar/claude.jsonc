// Bottom "claude" bar — its own waybar process so it can be shown/hidden
// independently of the top bar. Lifecycle is owned by
// `switchboard-ctl bottombar`, which starts this process when there is at
// least one claude session (and the top bar is visible) and kills it otherwise.
// Do not add this to an exec-once; the bottombar watcher launches it.
//
// Click bindings per chip: left = focus, right = picker, middle = rename the
// project abbreviation (claude-abbrev-edit), scroll = cycle sessions.
[
  {
    "name": "claude",
    "layer": "top",
    "position": "bottom",
    "height": 34,
    // Chips carry their own 2px margin, so this only sets the extra gap between
    // them. Kept small: barlayout.DefaultMetrics counts it in ChipFixedPx.
    "spacing": 2,
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,

    "modules-left": [],
    "modules-center": [
      "custom/claude-0", "custom/claude-1", "custom/claude-2", "custom/claude-3", "custom/claude-4",
      "custom/claude-5", "custom/claude-6", "custom/claude-7", "custom/claude-8", "custom/claude-9"
    ],
    "modules-right": [],

    "custom/claude-0": { "exec": "/home/tjmisko/go/bin/switchboard-waybar --slot 0", "return-type": "json", "on-click": "/home/tjmisko/go/bin/switchboard-ctl focus 0", "on-click-right": "/home/tjmisko/.config/scripts/claude-picker", "on-click-middle": "/home/tjmisko/.config/scripts/claude-abbrev-edit 0", "on-scroll-up": "/home/tjmisko/go/bin/switchboard-ctl cycle prev", "on-scroll-down": "/home/tjmisko/go/bin/switchboard-ctl cycle next", "tooltip": true },
    "custom/claude-1": { "exec": "/home/tjmisko/go/bin/switchboard-waybar --slot 1", "return-type": "json", "on-click": "/home/tjmisko/go/bin/switchboard-ctl focus 1", "on-click-right": "/home/tjmisko/.config/scripts/claude-picker", "on-click-middle": "/home/tjmisko/.config/scripts/claude-abbrev-edit 1", "on-scroll-up": "/home/tjmisko/go/bin/switchboard-ctl cycle prev", "on-scroll-down": "/home/tjmisko/go/bin/switchboard-ctl cycle next", "tooltip": true },
    "custom/claude-2": { "exec": "/home/tjmisko/go/bin/switchboard-waybar --slot 2", "return-type": "json", "on-click": "/home/tjmisko/go/bin/switchboard-ctl focus 2", "on-click-right": "/home/tjmisko/.config/scripts/claude-picker", "on-click-middle": "/home/tjmisko/.config/scripts/claude-abbrev-edit 2", "on-scroll-up": "/home/tjmisko/go/bin/switchboard-ctl cycle prev", "on-scroll-down": "/home/tjmisko/go/bin/switchboard-ctl cycle next", "tooltip": true },
    "custom/claude-3": { "exec": "/home/tjmisko/go/bin/switchboard-waybar --slot 3", "return-type": "json", "on-click": "/home/tjmisko/go/bin/switchboard-ctl focus 3", "on-click-right": "/home/tjmisko/.config/scripts/claude-picker", "on-click-middle": "/home/tjmisko/.config/scripts/claude-abbrev-edit 3", "on-scroll-up": "/home/tjmisko/go/bin/switchboard-ctl cycle prev", "on-scroll-down": "/home/tjmisko/go/bin/switchboard-ctl cycle next", "tooltip": true },
    "custom/claude-4": { "exec": "/home/tjmisko/go/bin/switchboard-waybar --slot 4", "return-type": "json", "on-click": "/home/tjmisko/go/bin/switchboard-ctl focus 4", "on-click-right": "/home/tjmisko/.config/scripts/claude-picker", "on-click-middle": "/home/tjmisko/.config/scripts/claude-abbrev-edit 4", "on-scroll-up": "/home/tjmisko/go/bin/switchboard-ctl cycle prev", "on-scroll-down": "/home/tjmisko/go/bin/switchboard-ctl cycle next", "tooltip": true },
    "custom/claude-5": { "exec": "/home/tjmisko/go/bin/switchboard-waybar --slot 5", "return-type": "json", "on-click": "/home/tjmisko/go/bin/switchboard-ctl focus 5", "on-click-right": "/home/tjmisko/.config/scripts/claude-picker", "on-click-middle": "/home/tjmisko/.config/scripts/claude-abbrev-edit 5", "on-scroll-up": "/home/tjmisko/go/bin/switchboard-ctl cycle prev", "on-scroll-down": "/home/tjmisko/go/bin/switchboard-ctl cycle next", "tooltip": true },
    "custom/claude-6": { "exec": "/home/tjmisko/go/bin/switchboard-waybar --slot 6", "return-type": "json", "on-click": "/home/tjmisko/go/bin/switchboard-ctl focus 6", "on-click-right": "/home/tjmisko/.config/scripts/claude-picker", "on-click-middle": "/home/tjmisko/.config/scripts/claude-abbrev-edit 6", "on-scroll-up": "/home/tjmisko/go/bin/switchboard-ctl cycle prev", "on-scroll-down": "/home/tjmisko/go/bin/switchboard-ctl cycle next", "tooltip": true },
    "custom/claude-7": { "exec": "/home/tjmisko/go/bin/switchboard-waybar --slot 7", "return-type": "json", "on-click": "/home/tjmisko/go/bin/switchboard-ctl focus 7", "on-click-right": "/home/tjmisko/.config/scripts/claude-picker", "on-click-middle": "/home/tjmisko/.config/scripts/claude-abbrev-edit 7", "on-scroll-up": "/home/tjmisko/go/bin/switchboard-ctl cycle prev", "on-scroll-down": "/home/tjmisko/go/bin/switchboard-ctl cycle next", "tooltip": true },
    "custom/claude-8": { "exec": "/home/tjmisko/go/bin/switchboard-waybar --slot 8", "return-type": "json", "on-click": "/home/tjmisko/go/bin/switchboard-ctl focus 8", "on-click-right": "/home/tjmisko/.config/scripts/claude-picker", "on-click-middle": "/home/tjmisko/.config/scripts/claude-abbrev-edit 8", "on-scroll-up": "/home/tjmisko/go/bin/switchboard-ctl cycle prev", "on-scroll-down": "/home/tjmisko/go/bin/switchboard-ctl cycle next", "tooltip": true },
    "custom/claude-9": { "exec": "/home/tjmisko/go/bin/switchboard-waybar --slot 9", "return-type": "json", "on-click": "/home/tjmisko/go/bin/switchboard-ctl focus 9", "on-click-right": "/home/tjmisko/.config/scripts/claude-picker", "on-click-middle": "/home/tjmisko/.config/scripts/claude-abbrev-edit 9", "on-scroll-up": "/home/tjmisko/go/bin/switchboard-ctl cycle prev", "on-scroll-down": "/home/tjmisko/go/bin/switchboard-ctl cycle next", "tooltip": true }
  }
]
