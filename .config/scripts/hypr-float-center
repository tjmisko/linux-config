#!/usr/bin/env bash
# hypr-float-center.sh — centered floating window manager with waybar awareness
#
# Usage:
#   hypr-float-center.sh <width%[xheight%]> [--terminal foot|wezterm] --class <name> <cmd...>
#   hypr-float-center.sh --reflow                            # reposition all tracked windows
#   hypr-float-center.sh --toggle-waybar                     # toggle waybar + reflow

set -euo pipefail

STATE_DIR="/tmp/hypr-float-center"
GAP=6
COMBINED_WAYBAR_MARKER="$HOME/.config/waybar/.switchboard-combined-v1"
COMBINED_WAYBAR_CONFIG="$HOME/.config/waybar/config.switchboard-combined.jsonc"
WAYBAR_READY_FILE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/switchboard/bottom-waybar.ready"

mkdir -p "$STATE_DIR"

# --- Helper: get monitor geometry + waybar offset for focused monitor ---
get_geometry() {
    local phys_w phys_h scale mon_name
    read -r phys_w phys_h scale mon_name < <(
        hyprctl monitors -j | jq -r '.[] | select(.focused) | "\(.width) \(.height) \(.scale) \(.name)"'
    )

    MON_W=$(awk "BEGIN {printf \"%d\", $phys_w / $scale}")
    MON_H=$(awk "BEGIN {printf \"%d\", $phys_h / $scale}")

    # A monitor hosts two waybar layers: the top status bar (namespace "top",
    # historically "waybar") and the bottom "claude" bar. Partition the bars by
    # which half of the screen they sit in, so the bottom bar is never mistaken
    # for the top offset (which would collapse the window to a sliver).
    TOP_OFFSET="$GAP"
    BOTTOM_OFFSET="$GAP"
    local wb_y wb_h
    while read -r wb_y wb_h; do
        [[ -z "$wb_y" ]] && continue
        if (( wb_y + wb_h / 2 < MON_H / 2 )); then
            local top=$(( wb_y + wb_h + GAP ))
            if (( top > TOP_OFFSET )); then TOP_OFFSET=$top; fi
        else
            local bot=$(( MON_H - wb_y + GAP ))
            if (( bot > BOTTOM_OFFSET )); then BOTTOM_OFFSET=$bot; fi
        fi
    done < <(hyprctl layers -j | jq -r --arg mon "$mon_name" \
        '.[$mon].levels | to_entries[].value[]? | select(.namespace == "waybar" or .namespace == "top" or .namespace == "claude") | "\(.y) \(.h)"' 2>/dev/null || true)

    # Override: if waybar is toggled hidden, both bars hide together.
    if [[ -f "$STATE_DIR/waybar-hidden" ]]; then
        TOP_OFFSET="$GAP"
        BOTTOM_OFFSET="$GAP"
    fi
}

# --- Helper: compute and apply window position ---
apply_position() {
    local class="$1" width_pct="$2" height_pct="${3:-100}"

    local avail_h=$(( MON_H - TOP_OFFSET - BOTTOM_OFFSET ))
    local win_w=$(( MON_W * width_pct / 100 ))
    local win_h=$(( avail_h * height_pct / 100 ))
    local win_x=$(( (MON_W - win_w) / 2 ))
    local win_y=$(( TOP_OFFSET + (avail_h - win_h) / 2 ))

    hyprctl dispatch "hl.dsp.window.resize({ x = ${win_w}, y = ${win_h}, exact = true, window = 'class:${class}' })"
    hyprctl dispatch "hl.dsp.window.move({ x = ${win_x}, y = ${win_y}, window = 'class:${class}' })"
}

# --- Helpers: identify, signal, and start the configured top-bar owner ---
# Combined mode gets its exact Waybar generation from the bottom module's
# readiness handshake. Split mode excludes the generation-aware bottom PID
# record; only its first field is the numeric PID.
_recorded_waybar_pid() {
    local record=$1 pid _started
    [[ -r "$record" ]] || return 1
    read -r pid _started < "$record"
    [[ "$pid" =~ ^[1-9][0-9]*$ ]] || return 1
    [[ -r "/proc/$pid/comm" ]] || return 1
    [[ "$(< "/proc/$pid/comm")" == "waybar" ]] || return 1
    printf '%s\n' "$pid"
}

_signal_top_waybar() {
    local sig="$1"
    if [[ -f "$COMBINED_WAYBAR_MARKER" ]]; then
        local combined_pid
        combined_pid=$(_recorded_waybar_pid "$WAYBAR_READY_FILE") || return 1
        kill -"$sig" "$combined_pid" 2>/dev/null
        return
    fi

    local bottom_pid=""
    local bottom_pid_file="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/switchboard/bottom-waybar.pid"
    bottom_pid=$(_recorded_waybar_pid "$bottom_pid_file") || bottom_pid=""

    local pid signaled=1
    for pid in $(pgrep -x waybar); do
        if [[ "$pid" != "$bottom_pid" ]] && kill -"$sig" "$pid" 2>/dev/null; then
            signaled=0
        fi
    done
    return "$signaled"
}

_start_top_waybar() {
    if [[ -f "$COMBINED_WAYBAR_MARKER" ]]; then
        waybar -c "$COMBINED_WAYBAR_CONFIG" &
    else
        waybar &
    fi
    disown
}

# --- Mode: --toggle-waybar ---
if [[ "${1:-}" == "--toggle-waybar" ]]; then
    if [[ -f "$STATE_DIR/waybar-hidden" ]]; then
        # Waybar is hidden → show the top bar
        rm "$STATE_DIR/waybar-hidden"
        _signal_top_waybar SIGUSR1 || _start_top_waybar
    else
        # Top bar is visible → hide it
        touch "$STATE_DIR/waybar-hidden"
        _signal_top_waybar SIGUSR1 || true
    fi

    # Re-derive the bottom "claude" bar: it is visible iff the top bar is
    # visible AND there is >=1 claude session. The marker we just flipped is
    # the top-visibility input; reconcile reads it and shows/hides the bottom
    # bar to match, keeping the two in lockstep.
    if [[ -f "$COMBINED_WAYBAR_MARKER" ]]; then
        "$HOME/.local/bin/switchboard-ctl" bottombar reconcile-attached 2>/dev/null || true
    else
        "$HOME/.local/bin/switchboard-ctl" bottombar reconcile 2>/dev/null || true
    fi

    # Brief sleep for waybar to animate/settle
    sleep 0.1

    # Reflow all tracked windows
    get_geometry

    for state_file in "$STATE_DIR"/*.conf; do
        [[ -f "$state_file" ]] || continue

        local_class=$(basename "$state_file" .conf)
        source "$state_file"

        exists=$(hyprctl clients -j | jq -r --arg c "$local_class" \
            '.[] | select(.class == $c) | .address' 2>/dev/null || true)

        if [[ -z "$exists" ]]; then
            rm -f "$state_file"
            continue
        fi

        apply_position "$local_class" "$WIDTH_PCT" "${HEIGHT_PCT:-100}"
    done
    exit 0
fi

# --- Mode: --reflow ---
if [[ "${1:-}" == "--reflow" ]]; then
    get_geometry

    for state_file in "$STATE_DIR"/*.conf; do
        [[ -f "$state_file" ]] || continue

        local_class=$(basename "$state_file" .conf)
        source "$state_file"

        # Check if window still exists
        exists=$(hyprctl clients -j | jq -r --arg c "$local_class" \
            '.[] | select(.class == $c) | .address' 2>/dev/null || true)

        if [[ -z "$exists" ]]; then
            rm -f "$state_file"
            continue
        fi

        apply_position "$local_class" "$WIDTH_PCT" "${HEIGHT_PCT:-100}"
    done
    exit 0
fi

# --- Mode: toggle ---
SIZE_SPEC="$1"
shift

# Parse WIDTHxHEIGHT or just WIDTH
if [[ "$SIZE_SPEC" == *x* ]]; then
    WIDTH_PCT="${SIZE_SPEC%%x*}"
    HEIGHT_PCT="${SIZE_SPEC##*x}"
else
    WIDTH_PCT="$SIZE_SPEC"
    HEIGHT_PCT=100
fi

# Extract --class <name>, --on-close <cmd>, and --terminal <term> from args
CLASS=""
ON_CLOSE=""
TERMINAL="wezterm"
ARGS=()
while [[ $# -gt 0 ]]; do
    if [[ "$1" == "--class" ]]; then
        CLASS="$2"
        ARGS+=("--class" "$2")
        shift 2
    elif [[ "$1" == "--on-close" ]]; then
        ON_CLOSE="$2"
        shift 2
    elif [[ "$1" == "--terminal" ]]; then
        TERMINAL="$2"
        shift 2
    else
        ARGS+=("$1")
        shift
    fi
done

if [[ -z "$CLASS" ]]; then
    echo "error: --class <name> is required" >&2
    exit 1
fi

# Toggle off: if window exists, move it to special:hidden
EXISTING=$(hyprctl clients -j | jq -r --arg c "$CLASS" \
    '.[] | select(.class == $c and .workspace.name != "special:hidden") | .address' 2>/dev/null || true)

if [[ -n "$EXISTING" ]]; then
    if [[ -n "$ON_CLOSE" ]]; then
        eval "$ON_CLOSE" 2>/dev/null || true
        sleep 0.2
    fi
    hyprctl dispatch "hl.dsp.window.move({ workspace = 'special:hidden', follow = false, window = 'class:$CLASS' })"
    exit 0
fi

# Toggle on: check if window is parked on special:hidden first
HIDDEN=$(hyprctl clients -j | jq -r --arg c "$CLASS" \
    '.[] | select(.class == $c and .workspace.name == "special:hidden") | .address' 2>/dev/null || true)

if [[ -n "$HIDDEN" ]]; then
    get_geometry
    ACTIVE_WS=$(hyprctl activeworkspace -j | jq -r '.id')
    hyprctl dispatch "hl.dsp.window.move({ workspace = $ACTIVE_WS, follow = false, window = 'class:$CLASS' })"
    apply_position "$CLASS" "$WIDTH_PCT" "$HEIGHT_PCT"
    hyprctl dispatch "hl.dsp.focus({ window = 'class:$CLASS' })"
    exit 0
fi

# No existing window — launch fresh
get_geometry

AVAIL_H=$(( MON_H - TOP_OFFSET - BOTTOM_OFFSET ))
WIN_W=$(( MON_W * WIDTH_PCT / 100 ))
WIN_H=$(( AVAIL_H * HEIGHT_PCT / 100 ))
WIN_X=$(( (MON_W - WIN_W) / 2 ))
WIN_Y=$(( TOP_OFFSET + (AVAIL_H - WIN_H) / 2 ))

printf "WIDTH_PCT=%s\nHEIGHT_PCT=%s\n" "$WIDTH_PCT" "$HEIGHT_PCT" > "$STATE_DIR/${CLASS}.conf"

# Build launch command based on terminal
case "$TERMINAL" in
    foot)
        # foot uses --app-id instead of --class
        TERM_ARGS=()
        for (( i=0; i<${#ARGS[@]}; i++ )); do
            if [[ "${ARGS[$i]}" == "--class" ]]; then
                TERM_ARGS+=("--app-id" "${ARGS[$((i+1))]}")
                (( ++i ))
            else
                TERM_ARGS+=("${ARGS[$i]}")
            fi
        done
        LAUNCH_CMD="foot ${TERM_ARGS[*]}"
        ;;
    *)
        LAUNCH_CMD="WEZTERM_FLOAT_TOGGLE=1 wezterm start --always-new-process ${ARGS[*]}"
        ;;
esac

hyprctl dispatch "hl.dsp.exec_cmd([[${LAUNCH_CMD}]], { float = true, size = '${WIN_W} ${WIN_H}', move = '${WIN_X} ${WIN_Y}' })"
