#!/bin/bash
# Claude Code Stop hook
# Sets state=idle via state daemon, sends notification if flagged

input=$(cat)

# Prevent loops
stop_hook_active=$(echo "$input" | jq -r '.stop_hook_active // false' 2>/dev/null)
[ "$stop_hook_active" = "true" ] && exit 0

session=$(tmux display-message -p "#{session_name}" 2>/dev/null)
[ -z "$session" ] && exit 0

STATE_LIB="$HOME/.local/lib/agent-session-switcher/state.sh"
[ -f "$STATE_LIB" ] || exit 0
source "$STATE_LIB"
state_init

uuid="$(state_find_uuid "$session")"
[ -z "$uuid" ] && exit 0

state_write_session "$uuid" "state" "idle"
state_write_session "$uuid" "idle_since" "$(date +%s)"

# Capture session_id for resume support
session_id=$(echo "$input" | jq -r '.session_id // empty' 2>/dev/null)
if [ -n "$session_id" ]; then
    state_write_session "$uuid" "resume_id" "$session_id"
fi

# Check for notify flag
NOTIFY_FLAG="/tmp/claude-notify-$session"
if [ -f "$NOTIFY_FLAG" ]; then
    last_msg=$(echo "$input" | jq -r '.last_assistant_message // empty' 2>/dev/null | head -c 100)
    notify-send "Claude: $session" "$last_msg" 2>/dev/null || true
    rm -f "$NOTIFY_FLAG"
fi
