#!/usr/bin/env bash
# claude-abbrev-edit — rename a project's switchboard abbreviation via rofi.
#
# Bound to on-click-middle on each bottom-bar claude slot in
# ~/.config/waybar/claude.jsonc; the argument is the slot index. It looks up the
# same aggregate slot's local session cwd, prompts (prefilled with the current
# abbreviation), and persists the new one with `switchboard-ctl name set`.
# Remote project paths are deliberately read-only on this machine.
set -euo pipefail

CTL=/home/tjmisko/.local/bin/switchboard-ctl
slot="${1:-}"
[[ -n "$slot" ]] || exit 0

# The Waybar slots index the complete aggregate, including headless and
# observe-only rows. Read that same snapshot instead of `pick`, which filters
# non-navigable rows and can therefore assign a different session to an index.
session=$("$CTL" -json list | jq -c --argjson slot "$slot" '.sessions[$slot] // empty')
[[ -n "$session" ]] || exit 0
if [[ $(jq -r '.remote // false' <<<"$session") == true ]]; then
    notify-send -t 1800 "switchboard" "remote project abbreviations are edited on their source host" 2>/dev/null || true
    exit 0
fi
cwd=$(jq -r '.cwd // empty' <<<"$session")
[[ -n "$cwd" ]] || exit 0

cur=$("$CTL" name abbrev --cwd "$cwd")
new=$(rofi -dmenu -p "abbrev for $(basename "$cwd")" -filter "$cur" < /dev/null) || exit 0
new=$(printf '%s' "$new" | tr -d '[:space:]')
[[ -n "$new" ]] || exit 0

"$CTL" name set "$cwd" "$new" >/dev/null
notify-send -t 1500 "switchboard" "abbrev: $(basename "$cwd") → $new" 2>/dev/null || true
