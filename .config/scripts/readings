#!/usr/bin/env bash
# Usage: readings [--rofi | --wofi] [--books | --articles | --readings | --guides]

MODE="fzf"
DIRS=(~/Books ~/Articles ~/Readings ~/Guides)

# Don't depend on the caller's PATH: a greetd-launched session starts with the
# system default, without ~/.local/bin (where htmlview lives).
export PATH="$HOME/.local/bin:$PATH"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --rofi)     MODE="rofi"; shift ;;
        --wofi)     MODE="wofi"; shift ;;
        --books)    DIRS=(~/Books); shift ;;
        --articles) DIRS=(~/Articles); shift ;;
        --readings) DIRS=(~/Readings); shift ;;
        --guides)   DIRS=(~/Guides); shift ;;
        *)          shift ;;
    esac
done

# --type f skips directories; the extension filter keeps saved-page assets
# (js/css/images under *_files/) out of the picker, and README.md files that
# describe a folder are not readings. --no-ignore-vcs because $HOME is a git
# repo and its .gitignore must not hide reading folders.
LIST="$(fd --type f --no-ignore-vcs -e pdf -e epub -e html -e md -e txt . "${DIRS[@]}" \
    --exclude '*_files' --exclude README.md | awk -F/ '{print $NF"\t"$0}')"

case "$MODE" in
    fzf)  SELECTION="$(echo "$LIST" | fzf --with-nth=1 --delimiter='\t')" ;;
    rofi) SELECTION="$(echo "$LIST" | rofi -dmenu -i)" ;;
    wofi) SELECTION="$(echo "$LIST" | wofi --show dmenu)" ;;
esac

READING_FILE="$(echo "$SELECTION" | cut -f2)"
[[ -z "$READING_FILE" ]] && exit 0

case "${READING_FILE,,}" in
    *.pdf|*.epub) zathura --fork "$READING_FILE" ;;
    *.html)       setsid -f htmlview "$READING_FILE" >/dev/null 2>&1 ;;
    *.md|*.txt)   wezterm start -- nvim "$READING_FILE" ;;
    *)            xdg-open "$READING_FILE" ;;
esac
