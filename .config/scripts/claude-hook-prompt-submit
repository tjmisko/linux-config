#!/bin/bash
# Claude Code UserPromptSubmit hook
# Sets state=working via state daemon, injects branch/cwd context

input=$(cat)
session=$(tmux display-message -p "#{session_name}" 2>/dev/null)
[ -z "$session" ] && exit 0

STATE_LIB="$HOME/.local/lib/agent-session-switcher/state.sh"
[ -f "$STATE_LIB" ] || exit 0
source "$STATE_LIB"
state_init

uuid="$(state_find_uuid "$session")"
[ -z "$uuid" ] && exit 0

state_write_session "$uuid" "state" "working"
state_write_session "$uuid" "idle_since" ""

# Check for notify keywords
prompt=$(echo "$input" | jq -r '.prompt // empty' 2>/dev/null)
if echo "$prompt" | grep -qiE '\bnotify\b|tell me when'; then
    touch "/tmp/claude-notify-$session"
fi

# Inject branch/cwd context for Claude
BRANCH=$(git branch --show-current 2>/dev/null || echo "not a git repo")
echo "pwd: $(pwd)"
echo "branch: $BRANCH"
