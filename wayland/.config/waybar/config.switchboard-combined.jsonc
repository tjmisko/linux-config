// Generated by scripts/merge-waybar-config. Edit the source configs, not this file.
[
  {
    "name": "top",
    "on-sigusr1": "toggle",
    "on-sigusr2": "noop",
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 6,
    "reload_style_on_change": true,

    "margin-top": 6,
    "margin-left": 6,
    "margin-right": 6,

    "modules-left": ["hyprland/workspaces"],

    "modules-center": [
      "custom/vollabel",
      "pulseaudio",
      "custom/sep",
      "network#wlan",
      "custom/sep",
      "battery",
      "custom/sep",
      "clock"
    ],

    "modules-right": ["tray", "custom/task", "custom/language"],

    "hyprland/workspaces": {
      "format": "{name}",
      "on-scroll-up": "hyprctl dispatch workspace e+1",
      "on-scroll-down": "hyprctl dispatch workspace e-1",
      "persistent-workspaces": {
        "eDP-1": [1, 2, 3, 4, 5, 6],
        "HDMI-A-1": [7, 8, 9]
      }
    },

    "custom/vollabel": {
      "format": "VOL"
    },

    "pulseaudio": {
      "format": "{volume}%",
      "format-muted": "muted",
      "scroll-step": 2
    },

    "network#wlan": {
      "interface-type": "wireless",
      "format-wifi": "{essid}",
      "format-disconnected": "{ifname} disconnected",
      "tooltip": true,
      "tooltip-format": "{essid} [{ipaddr}]",
      "interval": 5
    },

    "battery": {
      "bat": "macsmc-battery",
      "adapter": "macsmc-ac",
      "interval": 1,
      "states": { "warning": 20, "critical": 10 },
      "format": "<span foreground=\"#F0C674\">BAT</span> <span foreground=\"#C5C8C6\">{capacity}%</span>",
      "format-charging": "<span foreground=\"#F0C674\">CHR</span> <span foreground=\"#C5C8C6\">{capacity}%</span>",
      "format-full": "<span foreground=\"#A6F0C4\">FULL</span> <span foreground=\"#C5C8C6\">{capacity}%</span>",
      "format-warning": "<span foreground=\"#F0C674\">LOW</span> <span foreground=\"#C5C8C6\">{capacity}%</span>",
      "format-critical": "<span foreground=\"#f96644\">LOW</span> <span foreground=\"#C5C8C6\">{capacity}%</span>"
    },

    "clock": {
      "interval": 1,
      "format": "<span foreground=\"#F0C674\">{0:%Y-%m-%d}</span> <span foreground=\"#C5C8C6\">{0:%H:%M}</span>",
      "tooltip-format": "{:%Y-%m-%d %H:%M:%S %Z}",
      "escape": 0
    },

    "custom/task": {
      "exec": "/home/tjmisko/Tools/Tasks/task timer",
      "return-type": "text",
      "interval": 1
    },

    "custom/language": {
      "exec": "/home/tjmisko/.config/waybar/scripts/fcitx-lang.sh",
      "return-type": "text",
      "interval": 1,
      "tooltip": false
    },

    "custom/sep": {
      "format": "|",
      "tooltip": false
    },

    "tray": {
      "spacing": 16
    }
  }
,
  {
    "name": "claude",
    "start_hidden": true,
    "on-sigusr1": "noop",
    "on-sigusr2": "toggle",
    "layer": "top",
    "position": "bottom",
    "height": 34,
    "spacing": 2,
    "exclusive": true,
    "modules-left": [],
    "modules-center": [
      "custom/claude-0", "custom/claude-1", "custom/claude-2", "custom/claude-3", "custom/claude-4",
      "custom/claude-5", "custom/claude-6", "custom/claude-7", "custom/claude-8", "custom/claude-9"
    ],
    "modules-right": [],

    // Slot zero also acknowledges that this exact Waybar PID has completed a
    // module update. The broker withholds RT signals until that PID is ready,
    // then flushes every update accumulated during startup.
    "custom/claude-0": { "exec": "printf '%s ' \"$PPID\" > \"$XDG_RUNTIME_DIR/switchboard/bottom-waybar.ready\"; awk '{print $22}' \"/proc/$PPID/stat\" >> \"$XDG_RUNTIME_DIR/switchboard/bottom-waybar.ready\"; IFS= read -r line < \"$XDG_RUNTIME_DIR/switchboard/slot-0.json\"; printf '%s\\n' \"$line\"", "signal": 1, "return-type": "json", "exec-on-event": false, "on-click": "$HOME/.local/bin/switchboard-ctl focus idx:0", "on-click-right": "$HOME/.config/scripts/claude-picker", "on-click-middle": "$HOME/.config/scripts/claude-abbrev-edit 0", "on-scroll-up": "$HOME/.local/bin/switchboard-ctl cycle prev", "on-scroll-down": "$HOME/.local/bin/switchboard-ctl cycle next", "tooltip": true },
    "custom/claude-1": { "exec": "IFS= read -r line < \"$XDG_RUNTIME_DIR/switchboard/slot-1.json\"; printf '%s\\n' \"$line\"", "signal": 2, "return-type": "json", "exec-on-event": false, "on-click": "$HOME/.local/bin/switchboard-ctl focus idx:1", "on-click-right": "$HOME/.config/scripts/claude-picker", "on-click-middle": "$HOME/.config/scripts/claude-abbrev-edit 1", "on-scroll-up": "$HOME/.local/bin/switchboard-ctl cycle prev", "on-scroll-down": "$HOME/.local/bin/switchboard-ctl cycle next", "tooltip": true },
    "custom/claude-2": { "exec": "IFS= read -r line < \"$XDG_RUNTIME_DIR/switchboard/slot-2.json\"; printf '%s\\n' \"$line\"", "signal": 3, "return-type": "json", "exec-on-event": false, "on-click": "$HOME/.local/bin/switchboard-ctl focus idx:2", "on-click-right": "$HOME/.config/scripts/claude-picker", "on-click-middle": "$HOME/.config/scripts/claude-abbrev-edit 2", "on-scroll-up": "$HOME/.local/bin/switchboard-ctl cycle prev", "on-scroll-down": "$HOME/.local/bin/switchboard-ctl cycle next", "tooltip": true },
    "custom/claude-3": { "exec": "IFS= read -r line < \"$XDG_RUNTIME_DIR/switchboard/slot-3.json\"; printf '%s\\n' \"$line\"", "signal": 4, "return-type": "json", "exec-on-event": false, "on-click": "$HOME/.local/bin/switchboard-ctl focus idx:3", "on-click-right": "$HOME/.config/scripts/claude-picker", "on-click-middle": "$HOME/.config/scripts/claude-abbrev-edit 3", "on-scroll-up": "$HOME/.local/bin/switchboard-ctl cycle prev", "on-scroll-down": "$HOME/.local/bin/switchboard-ctl cycle next", "tooltip": true },
    "custom/claude-4": { "exec": "IFS= read -r line < \"$XDG_RUNTIME_DIR/switchboard/slot-4.json\"; printf '%s\\n' \"$line\"", "signal": 5, "return-type": "json", "exec-on-event": false, "on-click": "$HOME/.local/bin/switchboard-ctl focus idx:4", "on-click-right": "$HOME/.config/scripts/claude-picker", "on-click-middle": "$HOME/.config/scripts/claude-abbrev-edit 4", "on-scroll-up": "$HOME/.local/bin/switchboard-ctl cycle prev", "on-scroll-down": "$HOME/.local/bin/switchboard-ctl cycle next", "tooltip": true },
    "custom/claude-5": { "exec": "IFS= read -r line < \"$XDG_RUNTIME_DIR/switchboard/slot-5.json\"; printf '%s\\n' \"$line\"", "signal": 6, "return-type": "json", "exec-on-event": false, "on-click": "$HOME/.local/bin/switchboard-ctl focus idx:5", "on-click-right": "$HOME/.config/scripts/claude-picker", "on-click-middle": "$HOME/.config/scripts/claude-abbrev-edit 5", "on-scroll-up": "$HOME/.local/bin/switchboard-ctl cycle prev", "on-scroll-down": "$HOME/.local/bin/switchboard-ctl cycle next", "tooltip": true },
    "custom/claude-6": { "exec": "IFS= read -r line < \"$XDG_RUNTIME_DIR/switchboard/slot-6.json\"; printf '%s\\n' \"$line\"", "signal": 7, "return-type": "json", "exec-on-event": false, "on-click": "$HOME/.local/bin/switchboard-ctl focus idx:6", "on-click-right": "$HOME/.config/scripts/claude-picker", "on-click-middle": "$HOME/.config/scripts/claude-abbrev-edit 6", "on-scroll-up": "$HOME/.local/bin/switchboard-ctl cycle prev", "on-scroll-down": "$HOME/.local/bin/switchboard-ctl cycle next", "tooltip": true },
    "custom/claude-7": { "exec": "IFS= read -r line < \"$XDG_RUNTIME_DIR/switchboard/slot-7.json\"; printf '%s\\n' \"$line\"", "signal": 8, "return-type": "json", "exec-on-event": false, "on-click": "$HOME/.local/bin/switchboard-ctl focus idx:7", "on-click-right": "$HOME/.config/scripts/claude-picker", "on-click-middle": "$HOME/.config/scripts/claude-abbrev-edit 7", "on-scroll-up": "$HOME/.local/bin/switchboard-ctl cycle prev", "on-scroll-down": "$HOME/.local/bin/switchboard-ctl cycle next", "tooltip": true },
    "custom/claude-8": { "exec": "IFS= read -r line < \"$XDG_RUNTIME_DIR/switchboard/slot-8.json\"; printf '%s\\n' \"$line\"", "signal": 9, "return-type": "json", "exec-on-event": false, "on-click": "$HOME/.local/bin/switchboard-ctl focus idx:8", "on-click-right": "$HOME/.config/scripts/claude-picker", "on-click-middle": "$HOME/.config/scripts/claude-abbrev-edit 8", "on-scroll-up": "$HOME/.local/bin/switchboard-ctl cycle prev", "on-scroll-down": "$HOME/.local/bin/switchboard-ctl cycle next", "tooltip": true },
    "custom/claude-9": { "exec": "IFS= read -r line < \"$XDG_RUNTIME_DIR/switchboard/slot-9.json\"; printf '%s\\n' \"$line\"", "signal": 10, "return-type": "json", "exec-on-event": false, "on-click": "$HOME/.local/bin/switchboard-ctl focus idx:9", "on-click-right": "$HOME/.config/scripts/claude-picker", "on-click-middle": "$HOME/.config/scripts/claude-abbrev-edit 9", "on-scroll-up": "$HOME/.local/bin/switchboard-ctl cycle prev", "on-scroll-down": "$HOME/.local/bin/switchboard-ctl cycle next", "tooltip": true }
  }
]
