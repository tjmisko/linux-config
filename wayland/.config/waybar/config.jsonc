// Top bar with an optional live Switchboard circle view.
//
// Icons are Font Awesome 6 Free Solid private-use glyphs; fontconfig falls
// back to it from JetBrains Mono, so no per-span font switching is needed.
[
  {
    "name": "top",
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 0,
    "reload_style_on_change": true,
    "modules-left": [
      "hyprland/workspaces"
    ],
    "modules-center": [
      "pulseaudio",
      "pulseaudio/slider",
      "network#wlan",
      "battery",
      "custom/clock"
    ],
    "modules-right": [
      "cffi/switchboard",
      "custom/keyboard-internal",
      "tray",
      "custom/language"
    ],
    "hyprland/workspaces": {
      "format": "{name}",
      "on-scroll-up": "hyprctl dispatch workspace e+1",
      "on-scroll-down": "hyprctl dispatch workspace e-1",
      "persistent-workspaces": {
        "eDP-1": [
          1,
          2,
          3,
          4,
          5,
          6
        ],
        "HDMI-A-1": [
          7,
          8,
          9
        ]
      }
    },
    // Icon only; the level is drawn by pulseaudio/slider right after it.
    "pulseaudio": {
      "format": "{icon}",
      "format-muted": "",
      "format-icons": {
        "default": [
          "",
          "",
          ""
        ]
      },
      "tooltip-format": "{volume}%",
      "scroll-step": 2
    },
    "pulseaudio/slider": {
      "min": 0,
      "max": 100,
      "orientation": "horizontal"
    },
    "network#wlan": {
      "interface-type": "wireless",
      "format-wifi": " {essid}",
      "format-disconnected": " offline",
      "tooltip": true,
      "tooltip-format": "{essid} [{ipaddr}]",
      "interval": 5
    },
    "battery": {
      "bat": "macsmc-battery",
      "adapter": "macsmc-ac",
      "interval": 1,
      "states": {
        "warning": 20,
        "critical": 10
      },
      "format": "{icon} {capacity}%",
      "format-charging": " {capacity}%",
      "format-plugged": " {capacity}%",
      "format-full": " {capacity}%",
      "format-icons": [
        "",
        "",
        "",
        "",
        ""
      ]
    },
    // Streams its own JSON once a second; see scripts/clock.sh for why the
    // built-in clock module is not enough for the tooltip.
    "custom/clock": {
      "exec": "/home/tjmisko/.config/waybar/scripts/clock.sh",
      "return-type": "json",
      "escape": false
    },
    "custom/language": {
      "exec": "/home/tjmisko/.config/waybar/scripts/fcitx-lang.sh",
      "return-type": "text",
      "interval": 1,
      "tooltip": false
    },
    // Visible only while the built-in keyboard is disabled; clicking it is the
    // mouse-only way back. RTMIN+20 comes from keyboard-internal on each flip.
    "custom/keyboard-internal": {
      "exec": "/home/tjmisko/.config/scripts/keyboard-internal waybar",
      "return-type": "json",
      "interval": 5,
      "signal": 20,
      "on-click": "/home/tjmisko/.config/scripts/keyboard-internal enable"
    },
    "tray": {
      "icon-size": 15,
      "spacing": 10
    },
    "cffi/switchboard": {
      // A link through switchboard's `current` release; deploy maintains it.
      // Never a release directory: deploy prunes old ones.
      "module_path": "/home/tjmisko/.local/lib/switchboard/libswitchboard-waybar.so",
      "ctl": "/home/tjmisko/.local/bin/switchboard-ctl",
      "on-scroll-up": "/home/tjmisko/.local/bin/switchboard-ctl cycle prev",
      "on-scroll-down": "/home/tjmisko/.local/bin/switchboard-ctl cycle next",
      "on-click-right": "$HOME/.config/scripts/claude-picker",
      "tooltip": true
    }
  }
]
