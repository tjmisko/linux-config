# Overrides /usr/share/applications/nvim.desktop (same desktop-file ID).
# The system entry has Terminal=true, which lets GLib/xdg-open pick a terminal
# from a hardcoded list (xfce4-terminal is on it, wezterm is not). Launching
# wezterm directly makes every path that resolves to nvim.desktop -- mimeapps
# defaults, text/* subclass fallback, Firefox "open with system default" --
# land in wezterm.
[Desktop Entry]
Name=Neovim
GenericName=Text Editor
Comment=Edit text files
TryExec=nvim
Exec=wezterm start -- nvim %F
Terminal=false
Type=Application
Keywords=Text;editor;
Icon=nvim
Categories=Utility;TextEditor;Development;
StartupNotify=false
MimeType=text/plain;text/english;text/rust;text/x-python;text/x-python3;text/x-go;application/x-shellscript;application/x-csh;application/x-awk;application/x-powershell;application/x-bat;application/x-m4;application/x-shar;text/x-lua;application/x-ruby;application/x-perl;application/x-php;application/sql;text/javascript;text/css;text/x-scss;text/x-sass;text/markdown;text/x-rst;text/x-tex;text/x-bibtex;text/x-texinfo;application/yaml;application/toml;text/x-c;text/x-c++;text/x-csrc;text/x-chdr;text/x-c++src;text/x-c++hdr;text/x-objcsrc;text/x-csharp;text/x-java;text/x-kotlin;text/x-scala;text/x-groovy;text/x-gradle;text/x-haskell;text/x-literate-haskell;text/x-ocaml;text/x-elixir;text/x-erlang;text/x-scheme;text/x-emacs-lisp;text/x-vala;text/x-genie;text/x-nim;text/x-crystal;text/x-fortran;text/x-pascal;text/x-cobol;text/x-eiffel;text/x-matlab;text/x-qml;text/x-verilog;text/x-vhdl;text/x-devicetree-source;text/x-makefile;text/x-cmake;text/x-meson;text/x-scons;text/x-rpm-spec;text/x-patch;text/x-log;text/x-systemd-unit;application/x-desktop;text/x-gettext-translation;text/vnd.graphviz;text/x-readme;text/x-install;text/x-authors;text/x-changelog;text/x-copying;text/x-credits;text/x-moc;text/x-tcl;text/troff;text/x-ldif;text/x-idl;
