[Added Associations]
application/epub+zip=mupdf.desktop;

[Default Applications]
application/pdf=org.pwmt.zathura.desktop
application/epub+zip=org.pwmt.zathura.desktop
application/json=json-terminal.desktop
text/json=json-terminal.desktop
# Local .html opens in the bare WebKitGTK viewer; Firefox stays the fallback and
# keeps http/https, which are x-scheme-handler/* and unaffected by this line.
text/html=htmlview.desktop;org.mozilla.firefox.desktop;
application/xhtml+xml=htmlview.desktop;org.mozilla.firefox.desktop;
x-scheme-handler/obsidian=obsidian.desktop
inode/directory=nvim-oil.desktop
image/png=feh.desktop
image/jpeg=feh.desktop
image/gif=feh.desktop
image/bmp=feh.desktop
image/tiff=feh.desktop
image/webp=feh.desktop
image/svg+xml=feh.desktop
image/x-icon=feh.desktop
image/vnd.microsoft.icon=feh.desktop
image/x-portable-pixmap=feh.desktop
image/x-portable-bitmap=feh.desktop
image/x-portable-graymap=feh.desktop
image/x-xbitmap=feh.desktop
image/x-xpixmap=feh.desktop
x-scheme-handler/claude-cli=claude-code-url-handler.desktop
# Code and other plain-text types: nvim inside wezterm. nvim.desktop is the
# user-level override in .local/share/applications (Terminal=false, wezterm).
# Types not listed here still reach it through the text/plain subclass fallback.
text/plain=nvim.desktop
text/english=nvim.desktop
text/rust=nvim.desktop
text/x-python=nvim.desktop
text/x-python3=nvim.desktop
text/x-go=nvim.desktop
